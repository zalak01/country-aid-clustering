      <column caption='Country Short Name' datatype='string' name='[Calculation_386957755516841984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country]&#10;WHEN &quot;Central African Republic&quot; THEN &quot;Central African Rep.&quot;&#10;ELSE [country]&#10;END' />
      </column>
      <column caption='Import Export Gap' datatype='real' name='[Calculation_386957755719962625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[imports] - [exports]' />
      </column>
      <column caption='Trade Profile' datatype='string' name='[Calculation_386957755789082627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_386957755719962625] &gt; 0 THEN &quot;Imports &gt; Exports&quot;&#10;ELSEIF [Calculation_386957755719962625] &lt;0 THEN &quot;Exports &gt; Imports&quot;&#10;ELSE &quot;Balanced&quot;&#10;END' />
      </column>
      <column caption='Distinct Country Count' datatype='integer' name='[Calculation_4422605232253460480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([country])' />
      </column>
      <column caption='Income Group' datatype='string' name='[Calculation_4422605233640517634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [income] &lt; 5000 THEN &quot;Low Income&quot;&#10;ELSEIF [income] &lt; 20000 THEN &quot;Middle Income&quot;&#10;ELSE &quot;High Income&quot;&#10;END' />
      </column>
      <column aggregation='None' datatype='integer' name='[Income (bin)]' role='dimension' type='quantitative'>
